PORT=5000
# MongoDB connection string. Include a database name, e.g. /briefly?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/briefly?retryWrites=true&w=majority
# Long random string used to sign JWTs (generate one: openssl rand -hex 48)
JWT_SECRET=replace-with-a-long-random-secret
# Origins allowed to call the API, comma separated (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173
# News provider search endpoint and key. The key stays on the server.
NEWS_API_URL=https://api.currentsapi.services/v1/search?keywords=India
NEWS_API_KEY=your-news-api-key
